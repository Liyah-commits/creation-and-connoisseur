# Copy to .env for local development. Never commit .env.
# In production, set these in Vercel: Project Settings > Environment Variables.
# docs/ADMIN_GUIDE.md explains each one.

# The public address of the site, without a trailing slash. Leave empty until the
# domain is known; Vercel's production address is used instead.
SITE_URL=

# Formspree form ID (the part after /f/ in the form's endpoint). Leave empty and
# the forms show a "not connected yet" notice instead of sending.
FORMSPREE_FORM_ID=

# Include draft entries in the build. Only for the template test build.
SHOW_DRAFTS=false

# Keystatic in production (GitHub mode). Not needed for `pnpm dev`, which saves to local files.
PUBLIC_KEYSTATIC_GITHUB_REPO=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
