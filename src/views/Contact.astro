---
/**
 * Contact: the contact form first, then "Other ways to reach us": contact
 * details entered in Site settings, the page's main text (which holds the
 * UNLV Food Tasting Club's own email, kept out of Site settings so a unlv.edu
 * address never reads as the nonprofit's), and the social links.
 * The section hides while all three are empty.
 */
import Base from '../layouts/Base.astro';
import Form from '../components/Form.astro';
import PageHeader from '../components/PageHeader.astro';
import Prose from '../components/Prose.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { alternatesFor, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getPage, getSettings, hasBody } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const page = await getPage(lang, 'contact');
const settings = await getSettings();
const addressLines = settings.mailingAddress.split('\n').map((line) => line.trim()).filter(Boolean);
const hasSettingsDetails = Boolean(settings.email || settings.phone || addressLines.length);
const hasSocial = settings.socialLinks.length > 0;
const hasDetails = hasSettingsDetails || hasBody(page) || hasSocial;
---

<Base lang={lang} title={page.data.title} description={page.data.metaDescription} alternates={alternatesFor('contact')}>
  <PageHeader title={page.data.title} intro={page.data.intro} />
  <div class="container-page py-10 md:py-14">
    <Form lang={lang} kind="contact" />
    {
      hasDetails && (
        <section aria-labelledby="details-heading" class="mt-12 max-w-[68ch]">
          <h2 id="details-heading">{t(lang, 'contact.detailsHeading')}</h2>
          {hasSettingsDetails && (
            <dl class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-[auto_1fr]">
              {settings.email && (<><dt class="font-semibold">{t(lang, 'contact.email')}</dt><dd><a href={`mailto:${settings.email}`}>{settings.email}</a></dd></>)}
              {settings.phone && (<><dt class="font-semibold">{t(lang, 'contact.phone')}</dt><dd><a href={`tel:${settings.phone.replace(/[^\d+]/g, '')}`}>{settings.phone}</a></dd></>)}
              {addressLines.length > 0 && (<><dt class="font-semibold">{t(lang, 'contact.address')}</dt><dd><address class="not-italic">{addressLines.map((line, i) => (<>{line}{i < addressLines.length - 1 && <br />}</>))}</address></dd></>)}
            </dl>
          )}
          <Prose entry={page} class="mt-4" />
          {hasSocial && (
            <>
              <h3 class="mt-8">{t(lang, 'footer.socialHeading')}</h3>
              <SocialLinks links={settings.socialLinks} surface="light" class="mt-3" />
            </>
          )}
        </section>
      )
    }
  </div>
</Base>
