---
/** Volunteer: the volunteering photo in the page header (from "Photos and stats" in Keystatic), the roles, and the volunteer form. */
import StandardPage from './StandardPage.astro';
import Form from '../components/Form.astro';
import type { Lang } from '../i18n/routes';
import { getHighlights } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const photo = (await getHighlights()).volunteerPhoto;
const headerImage = photo.discriminant ? { src: photo.value.image, alt: lang === 'en' ? photo.value.altEn : photo.value.altEs } : null;
---

<StandardPage lang={lang} pageKey="volunteer" headerImage={headerImage}>
  <Form lang={lang} kind="volunteer" />
</StandardPage>
