---
/** Volunteer: the roles and the volunteer form. The header photo comes from "Photos and stats" through StandardPage. */
import StandardPage from './StandardPage.astro';
import Form from '../components/Form.astro';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<StandardPage lang={lang} pageKey="volunteer">
  <Form lang={lang} kind="volunteer" />
</StandardPage>
