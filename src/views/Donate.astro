---
/**
 * Donate. Until a donation link is entered in Site settings, the button reads
 * "Donation link coming soon" and is marked aria-disabled: it stays in the tab
 * order so screen reader users find it and hear that it is unavailable.
 */
import StandardPage from './StandardPage.astro';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { getSettings } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const settings = await getSettings();
---

<StandardPage lang={lang} pageKey="donate">
  <div class="card mt-10 max-w-[68ch] p-6">
    {
      settings.donationUrl ? (
        <a href={settings.donationUrl} class="btn btn-primary text-lg">
          {t(lang, 'donate.button')}
          <span class="sr-only"> {t(lang, 'donate.leavesSite')}</span>
        </a>
      ) : (
        <>
          <button type="button" class="btn text-lg" aria-disabled="true" aria-describedby="donate-note">
            {t(lang, 'donate.comingSoon')}
          </button>
          <p id="donate-note" class="mt-3 text-ink-muted">{t(lang, 'donate.comingSoonNote')}</p>
        </>
      )
    }
    {
      (settings.legalName || settings.ein) && (
        <dl class="mt-6 grid gap-x-4 gap-y-1 sm:grid-cols-[auto_1fr]">
          {settings.legalName && (<><dt class="font-semibold">{t(lang, 'donate.legalName')}</dt><dd>{settings.legalName}</dd></>)}
          {settings.ein && (<><dt class="font-semibold">{t(lang, 'footer.ein')}</dt><dd>{settings.ein}</dd></>)}
        </dl>
      )
    }
  </div>
</StandardPage>
