---
/**
 * One bilingual "not found" page. Vercel serves it with status 404 for any
 * unknown address, in either language, so both languages are on the page.
 * The Spanish half is marked lang="es" so screen readers switch voice.
 */
import Base from '../layouts/Base.astro';
import { routes } from '../i18n/routes';
---

<Base lang="en" title="Page not found / Página no encontrada" description="The page you were looking for could not be found. La página que buscabas no se encontró." alternates={{ en: '/', es: '/es/' }} translated={false} noindex>
  <div class="container-page py-14 md:py-20">
    <h1>Page not found <span class="block text-ink-muted" lang="es">Página no encontrada</span></h1>
    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <section aria-labelledby="nf-en" class="max-w-[60ch]">
        <h2 id="nf-en" class="text-2xl">English</h2>
        <p class="mt-3">We couldn't find that page. It may have moved, or the address may have a typo.</p>
        <p class="mt-3"><a href={routes.home.en}>Go to the home page</a></p>
      </section>
      <section aria-labelledby="nf-es" lang="es" class="max-w-[60ch]">
        <h2 id="nf-es" class="text-2xl">Español</h2>
        <p class="mt-3">No encontramos esa página. Es posible que se haya movido o que la dirección tenga un error.</p>
        <p class="mt-3"><a href={routes.home.es}>Ir a la página de inicio</a></p>
      </section>
    </div>
  </div>
</Base>
