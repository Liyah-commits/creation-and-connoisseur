---
/**
 * One person on the About page. Every card shows the person's initials in a
 * solid sage circle (sand-50 text, DM Serif Display, 6.87:1), never a photo
 * (D58): the club portraits have names and titles burned in. The circle is
 * decorative (aria-hidden), because the name is the card's heading.
 */
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  person: CollectionEntry<'people'>;
}
const { lang, person } = Astro.props;
const { name } = person.data;
const role = lang === 'en' ? person.data.roleEn : person.data.roleEs;
const bio = lang === 'en' ? person.data.bioEn : person.data.bioEs;
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .slice(0, 2)
  .join('');
---

<article class="card flex h-full gap-5 p-5">
  <div class="initials flex size-28 shrink-0 items-center justify-center rounded-full bg-sage" aria-hidden="true">
    <span class="font-serif text-4xl leading-none text-sand-50">{initials}</span>
  </div>
  <div>
    <h3>{name}</h3>
    {role && <p class="mt-1 font-semibold text-ink-muted">{role}</p>}
    {bio && <p class="mt-2">{bio}</p>}
  </div>
</article>
