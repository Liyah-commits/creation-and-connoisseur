---
/** One person on the About page. Without a photo, a decorative initials block stands in. */
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
  person: CollectionEntry<'people'>;
}
const { lang, person } = Astro.props;
const { name, photo } = person.data;
const role = lang === 'en' ? person.data.roleEn : person.data.roleEs;
const bio = lang === 'en' ? person.data.bioEn : person.data.bioEs;
const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .map((part) => part[0]?.toUpperCase() ?? '')
  .slice(0, 2)
  .join('');
---

<article class="card flex gap-5 p-5">
  {
    photo.discriminant ? (
      <div class="size-28 shrink-0 overflow-hidden rounded-full border border-sandstone">
        <Picture src={photo.value.image} alt={lang === 'en' ? photo.value.altEn : photo.value.altEs} widths={[112, 224]} sizes="7rem" formats={['avif']} fallbackFormat="webp" class="size-full object-cover" />
      </div>
    ) : (
      <div class="placeholder-pattern flex size-28 shrink-0 items-center justify-center rounded-full border border-sandstone" aria-hidden="true">
        <span class="inline-block rounded bg-white px-2 py-0.5 font-serif text-2xl leading-tight text-ink">{initials}</span>
      </div>
    )
  }
  <div>
    <h3>{name}</h3>
    {role && <p class="mt-1 font-semibold text-ink-muted">{role}</p>}
    {bio && <p class="mt-2">{bio}</p>}
  </div>
</article>
