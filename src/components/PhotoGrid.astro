---
/**
 * A grid of photos, each with its description as alt text. By default photos
 * keep their own shape (portrait or landscape), so no one is cropped out
 * (program and news galleries). With `aspect="3/2"` every photo is cropped to
 * the same shape so the rows stay even (About, club life, D58). They sit below
 * the fold, so they load lazily (Astro's default).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  photos: { image: ImageMetadata; alt: string }[];
  /** Crop every photo to 3:2 so the rows are even. */
  aspect?: '3/2';
  class?: string;
}
const { photos, aspect, class: className } = Astro.props;
---

<ul class:list={['grid gap-5 sm:grid-cols-2 lg:grid-cols-3', !aspect && 'items-start', className]} role="list">
  {
    photos.map((photo) => (
      <li>
        <Picture
          src={photo.image}
          alt={photo.alt}
          widths={[400, 800]}
          sizes="(min-width: 72rem) 22rem, (min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          class:list={['w-full rounded-xl border border-sandstone', aspect ? 'aspect-[3/2] object-cover' : 'h-auto']}
        />
      </li>
    ))
  }
</ul>
