---
/**
 * A grid of photos, each with its description as alt text. Photos keep their
 * own shape (portrait or landscape), so no one is cropped out. They sit below
 * the fold, so they load lazily (Astro's default).
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  photos: { image: ImageMetadata; alt: string }[];
  class?: string;
}
const { photos, class: className } = Astro.props;
---

<ul class:list={['grid items-start gap-5 sm:grid-cols-2 lg:grid-cols-3', className]} role="list">
  {
    photos.map((photo) => (
      <li>
        <Picture
          src={photo.image}
          alt={photo.alt}
          widths={[400, 800]}
          sizes="(min-width: 72rem) 22rem, (min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          class="h-auto w-full rounded-lg border border-ink/10"
        />
      </li>
    ))
  }
</ul>
