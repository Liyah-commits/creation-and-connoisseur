---
/**
 * Site header: skip link (first focusable element), language switch, Donate
 * button, logo (the mark and the wordmark as live text) and main navigation.
 * A 2px sandstone rule runs under it (D55).
 *
 * The navigation is visible without JavaScript. With JavaScript, small screens
 * get a disclosure button (aria-expanded / aria-controls); Escape closes it and
 * returns focus to the button. There is no focus trap, and the header is not
 * sticky, so it never covers focused content (WCAG 2.4.11).
 */
import LogoMark from './LogoMark.astro';
import { otherLang, routes, type Alternates, type Lang, type RouteKey } from '../i18n/routes';
import { navLabel, t } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternates: Alternates;
}

const { lang, alternates } = Astro.props;
const other = otherLang(lang);
const path = Astro.url.pathname;

const navKeys: RouteKey[] = ['getHelp', 'programs', 'volunteer', 'news', 'about', 'contact'];

/** "page" for the current page, "true" for the section an entry page belongs to. */
function current(key: RouteKey): 'page' | 'true' | undefined {
  const href = routes[key][lang];
  if (path === href) return 'page';
  if ((key === 'programs' || key === 'news') && path.startsWith(href)) return 'true';
  return undefined;
}
---

<header class="site-header border-b-2 border-sandstone bg-sand-50">
  <a href="#main" class="skip-link">{t(lang, 'skip.toMain')}</a>

  <div class="container-page">
    <div class="flex flex-wrap items-center justify-end gap-x-3 gap-y-2 pt-3">
      <a
        href={alternates[other]}
        lang={other}
        hreflang={other}
        class="lang-switch inline-flex min-h-11 items-center px-2 font-semibold"
      >
        {t(lang, 'lang.switchTo')}<span class="sr-only">: {t(lang, 'lang.switchHint')}</span>
      </a>
      <a
        href={routes.donate[lang]}
        class="btn btn-accent"
        aria-current={path === routes.donate[lang] ? 'page' : undefined}
      >
        {t(lang, 'nav.donate')}
      </a>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-2 pb-4">
      <a href={routes.home[lang]} class="wordmark inline-flex items-center gap-3 font-serif text-2xl leading-tight text-ink no-underline sm:text-3xl" aria-current={path === routes.home[lang] ? 'page' : undefined}>
        <LogoMark size={40} />
        <span>Creation <span class="text-sage italic">and</span> Connoisseur</span>
      </a>

      <nav aria-label={t(lang, 'nav.label')} class="site-nav" data-site-nav>
        <button type="button" class="menu-button btn btn-secondary" aria-expanded="false" aria-controls="site-menu" data-menu-button>
          <svg aria-hidden="true" focusable="false" width="20" height="20" viewBox="0 0 20 20" class="menu-icon">
            <path d="M2 5h16M2 10h16M2 15h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"></path>
          </svg>
          {t(lang, 'nav.menu')}
        </button>
        <ul id="site-menu" class="menu-list" role="list">
          {
            navKeys.map((key) => (
              <li>
                <a href={routes[key][lang]} aria-current={current(key)} class="nav-link">
                  {navLabel(lang, key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  .wordmark:hover {
    text-decoration-line: underline;
  }

  .lang-switch {
    color: var(--color-ink);
  }

  /* Without JavaScript there is no menu button: the list is simply shown. */
  .menu-button {
    display: none;
  }

  .menu-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.25rem;
    color: var(--color-ink);
    font-weight: 600;
  }

  .nav-link[aria-current] {
    color: var(--color-sage);
    text-decoration-thickness: 3px;
  }

  /* Small screens with JavaScript: the list is a disclosure, closed by default. */
  @media (max-width: 63.999rem) {
    :global(.js) .menu-button {
      display: inline-flex;
    }

    :global(.js) .site-nav {
      width: 100%;
    }

    :global(.js) .menu-list {
      display: none;
      flex-direction: column;
      gap: 0;
      margin-top: 0.75rem;
      border-top: 1px solid rgb(38 48 42 / 0.15);
    }

    :global(.js) .menu-list.is-open {
      display: flex;
    }

    :global(.js) .menu-list li {
      border-bottom: 1px solid rgb(38 48 42 / 0.15);
    }

    :global(.js) .nav-link {
      width: 100%;
      padding-block: 0.5rem;
    }
  }

  .menu-button[aria-expanded='true'] .menu-icon path {
    d: path('M4 4l12 12M16 4L4 16');
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>('[data-site-nav]');
  const button = nav?.querySelector<HTMLButtonElement>('[data-menu-button]');
  const menu = button ? document.getElementById(button.getAttribute('aria-controls') ?? '') : null;

  if (nav && button && menu) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('is-open', open);
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes the menu and puts focus back on the button.
    nav.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        button.focus();
      }
    });
  }
</script>
