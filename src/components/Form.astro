---
/**
 * The Contact and Volunteer forms.
 *
 * Accessible by design (WCAG 1.3.1, 1.3.5, 3.3.1, 3.3.2, 4.1.3):
 * - every field has a visible label, and required fields say "(required)" in text;
 * - hints and error messages are linked to their field with aria-describedby;
 * - on submit, invalid fields get aria-invalid and an inline message, and focus
 *   moves to the first one;
 * - the result is announced through a role="status" live region that is in the
 *   page from the start (so screen readers are already listening to it);
 * - personal fields use autocomplete tokens.
 *
 * Progressive enhancement: without JavaScript the browser's own validation runs
 * and the form posts straight to Formspree. With JavaScript the form validates
 * itself (novalidate is set by the script) and sends in the background.
 *
 * When FORMSPREE_FORM_ID is not set, the form still renders, a plain-text
 * notice says it isn't connected, and a valid submit announces that nothing
 * was sent.
 */
import { FORMSPREE_FORM_ID } from 'astro:env/server';
import { routes, type Lang } from '../i18n/routes';
import { t, type UIKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  kind: 'contact' | 'volunteer';
}
const { lang, kind } = Astro.props;

type Field = {
  name: string;
  label: UIKey;
  type: 'text' | 'email' | 'tel' | 'textarea';
  required: boolean;
  autocomplete?: string;
  hint?: UIKey;
  /** Message when required and empty. */
  missing?: UIKey;
  rows?: number;
};

const fields: Field[] =
  kind === 'contact'
    ? [
        { name: 'name', label: 'form.name', type: 'text', required: true, autocomplete: 'name', missing: 'form.errorNameMissing' },
        { name: 'email', label: 'form.email', type: 'email', required: true, autocomplete: 'email', hint: 'form.emailHint', missing: 'form.errorEmailMissing' },
        { name: 'message', label: 'form.message', type: 'textarea', required: true, missing: 'form.errorMessageMissing', rows: 7 },
      ]
    : [
        { name: 'name', label: 'form.name', type: 'text', required: true, autocomplete: 'name', missing: 'form.errorNameMissing' },
        { name: 'email', label: 'form.email', type: 'email', required: true, autocomplete: 'email', hint: 'form.emailHint', missing: 'form.errorEmailMissing' },
        { name: 'phone', label: 'form.phone', type: 'tel', required: false, autocomplete: 'tel' },
        { name: 'interests', label: 'form.interests', type: 'textarea', required: true, hint: 'form.interestsHint', missing: 'form.errorInterestsMissing', rows: 5 },
        { name: 'availability', label: 'form.availability', type: 'textarea', required: false, hint: 'form.availabilityHint', rows: 3 },
      ];

const formId = FORMSPREE_FORM_ID?.trim();
const connected = Boolean(formId);
const action = connected ? `https://formspree.io/f/${encodeURIComponent(formId!)}` : routes[kind][lang];
const id = (name: string) => `${kind}-${name}`;
const subject = t(lang, kind === 'contact' ? 'form.subjectContact' : 'form.subjectVolunteer');
const success = t(lang, kind === 'contact' ? 'form.successContact' : 'form.successVolunteer');

// Messages the script needs, in this page's language.
const messages = {
  prefix: t(lang, 'form.errorPrefix'),
  emailInvalid: t(lang, 'form.errorEmailInvalid'),
  success,
  failure: t(lang, 'form.failure'),
  notConnected: t(lang, 'form.notConnectedSubmit'),
  sending: t(lang, 'form.sending'),
};
---

<div class="form-wrap mt-10 max-w-[40rem]">
  {
    !connected && (
      <p class="mb-6 rounded-lg border-2 border-ink-muted bg-white p-4" id={id('notice')}>
        <strong>{t(lang, 'form.notConnected')}</strong>
      </p>
    )
  }

  <form
    action={action}
    method="post"
    class="space-y-6 rounded-lg border border-ink/15 bg-white p-5 sm:p-8"
    data-form
    data-connected={connected ? 'true' : 'false'}
    data-messages={JSON.stringify(messages)}
    aria-describedby={connected ? `${id('required-note')}` : `${id('notice')} ${id('required-note')}`}
  >
    <p id={id('required-note')} class="text-ink-muted">{t(lang, 'form.requiredNote')}</p>

    {
      fields.map((field) => {
        const describedBy = [field.hint ? id(`${field.name}-hint`) : null].filter(Boolean).join(' ') || undefined;
        const common = {
          id: id(field.name),
          name: field.name,
          required: field.required,
          autocomplete: field.autocomplete,
          'aria-describedby': describedBy,
          'data-missing': field.missing ? t(lang, field.missing) : undefined,
          class: 'field-input',
        };
        return (
          <div class="field" data-field>
            <label for={id(field.name)} class="block font-semibold">
              {t(lang, field.label)} <span class="font-normal text-ink-muted">{t(lang, field.required ? 'form.required' : 'form.optional')}</span>
            </label>
            {field.hint && (
              <p id={id(`${field.name}-hint`)} class="mt-1 text-ink-muted">
                {t(lang, field.hint)}
              </p>
            )}
            <p id={id(`${field.name}-error`)} class="field-error mt-1 font-semibold" data-error hidden />
            {field.type === 'textarea' ? (
              <textarea {...common} rows={field.rows ?? 4} />
            ) : (
              <input {...common} type={field.type} spellcheck={field.type === 'email' ? 'false' : undefined} />
            )}
          </div>
        );
      })
    }

    <input type="hidden" name="_subject" value={subject} />
    <input type="hidden" name="_language" value={lang} />
    <div style="display:none" aria-hidden="true">
      <label for={id('gotcha')}>{t(lang, 'form.honeypot')}</label>
      <input type="text" id={id('gotcha')} name="_gotcha" tabindex="-1" autocomplete="off" />
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <button type="submit" class="btn btn-primary" data-submit>
        {t(lang, kind === 'contact' ? 'form.submitContact' : 'form.submitVolunteer')}
      </button>
    </div>

    <div role="status" aria-live="polite" aria-atomic="true" class="form-status" data-status></div>

    <p class="text-sm text-ink-muted">
      {t(lang, 'form.privacy')} <a href={routes.privacy[lang]}>{t(lang, 'form.privacyLink')}</a>.
    </p>
  </form>
</div>

<style>
  .field-input {
    display: block;
    width: 100%;
    margin-top: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 2px solid var(--color-ink-muted);
    border-radius: 0.375rem;
    background-color: var(--color-white);
    color: var(--color-ink);
    font: inherit;
  }

  .field-input[aria-invalid='true'] {
    border-color: var(--color-tomato-dark);
    border-width: 3px;
  }

  .field-error {
    color: var(--color-tomato-dark);
  }

  .form-status:not(:empty) {
    padding: 1rem;
    border-radius: 0.375rem;
    border: 2px solid var(--color-herb);
    background-color: var(--color-cream);
    font-weight: 600;
  }

  .form-status[data-state='error']:not(:empty) {
    border-color: var(--color-tomato-dark);
  }
</style>

<script>
  type Messages = { prefix: string; emailInvalid: string; success: string; failure: string; notConnected: string; sending: string };
  type Control = HTMLInputElement | HTMLTextAreaElement;

  // A simple, permissive check: something@something.something, no spaces.
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-form]')) {
    const messages: Messages = JSON.parse(form.dataset.messages ?? '{}');
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const submitLabel = submit.textContent?.trim() ?? '';
    const controls = [...form.querySelectorAll<Control>('.field-input')];

    // JavaScript is running, so the form validates itself.
    form.noValidate = true;

    const errorFor = (control: Control) => document.getElementById(`${control.id}-error`)!;

    /** The message for a field, or null when it's valid. */
    const problem = (control: Control): string | null => {
      const value = control.value.trim();
      if (control.required && !value) return control.dataset.missing ?? '';
      if (control.type === 'email' && value && !EMAIL.test(value)) return messages.emailInvalid;
      return null;
    };

    const setError = (control: Control, message: string | null) => {
      const error = errorFor(control);
      const ids = (control.getAttribute('aria-describedby') ?? '').split(' ').filter((x) => x && x !== error.id);
      if (message) {
        error.textContent = `${messages.prefix} ${message}`;
        error.hidden = false;
        control.setAttribute('aria-invalid', 'true');
        ids.push(error.id);
      } else {
        error.textContent = '';
        error.hidden = true;
        control.removeAttribute('aria-invalid');
      }
      if (ids.length) control.setAttribute('aria-describedby', ids.join(' '));
      else control.removeAttribute('aria-describedby');
    };

    // Once a field has been marked invalid, clear the message as soon as it's fixed.
    for (const control of controls) {
      control.addEventListener('input', () => {
        if (control.getAttribute('aria-invalid') === 'true' && !problem(control)) setError(control, null);
      });
    }

    const announce = (text: string, state: 'ok' | 'error') => {
      status.dataset.state = state;
      // Clear first so the same message is announced again on a repeat submit.
      status.textContent = '';
      window.setTimeout(() => {
        status.textContent = text;
      }, 50);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.getAttribute('aria-disabled') === 'true') return; // already sending
      status.textContent = '';

      const invalid: Control[] = [];
      for (const control of controls) {
        const message = problem(control);
        setError(control, message);
        if (message) invalid.push(control);
      }
      if (invalid.length) {
        invalid[0]!.focus();
        return;
      }

      if (form.dataset.connected !== 'true') {
        announce(messages.notConnected, 'error');
        return;
      }

      submit.setAttribute('aria-disabled', 'true');
      submit.textContent = messages.sending;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error(`Formspree responded ${response.status}`);
        form.reset();
        announce(messages.success, 'ok');
      } catch {
        announce(messages.failure, 'error');
      } finally {
        submit.removeAttribute('aria-disabled');
        submit.textContent = submitLabel;
      }
    });
  }
</script>
