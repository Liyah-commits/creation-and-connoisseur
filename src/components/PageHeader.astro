---
/**
 * The top of every page: the one h1, an optional introduction, and a 2px
 * sandstone rule underneath (D55). When the page has a header photo (D58), it
 * sits in an 18rem column on screens 768px and wider, cropped to 4:3 from the
 * top (faces, not the text some photos have printed low) and rounded like
 * the cards; below 768px it is not shown. It sits above the fold, so it loads
 * eagerly (with async decoding), and its frame has a sand background, so it
 * never shows as an empty white box while the photo arrives (D62). Without a
 * photo the text spans the full width: there is never an empty or decorative
 * image slot.
 */
import { Picture } from 'astro:assets';
import type { Photo } from '../lib/content';

interface Props {
  title: string;
  intro?: string | undefined;
  image?: Photo | null | undefined;
}
const { title, intro, image } = Astro.props;
---

<div class="border-b-2 border-sandstone bg-white">
  <div class:list={['container-page grid items-center gap-8 py-10 md:py-14', image && 'md:grid-cols-[minmax(0,1fr)_18rem]']}>
    <div>
      <h1>{title}</h1>
      {intro && <p class="lead mt-4 text-ink-muted">{intro}</p>}
      <slot />
    </div>
    {
      image && (
        <div class="hidden md:block" data-header-photo>
          <Picture
            src={image.image}
            alt={image.alt}
            widths={[288, 576]}
            sizes="18rem"
            formats={['avif']}
            fallbackFormat="webp"
            loading="eager"
            decoding="async"
            class="aspect-[4/3] w-[18rem] rounded-xl border border-sandstone bg-sand object-cover object-top"
          />
        </div>
      )
    }
  </div>
</div>
