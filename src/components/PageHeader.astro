---
/**
 * The top of every page: the one h1, an optional introduction, and a 2px
 * sandstone rule underneath (D55). On the right, a photo when the page has one
 * (the Volunteer page's volunteering photo, D56), otherwise a decorative
 * pattern. The photo is never shown wider than 900px and loads lazily: only
 * the Home photo loads eagerly.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  title: string;
  intro?: string | undefined;
  image?: { src: ImageMetadata; alt: string } | null | undefined;
}
const { title, intro, image } = Astro.props;
---

<div class="border-b-2 border-sandstone bg-white">
  <div class:list={['container-page grid items-center gap-8 py-10 md:py-14', image ? 'md:grid-cols-[3fr_2fr]' : 'md:grid-cols-[1fr_auto]']}>
    <div>
      <h1>{title}</h1>
      {intro && <p class="lead mt-4 text-ink-muted">{intro}</p>}
      <slot />
    </div>
    {
      image ? (
        <Picture
          src={image.src}
          alt={image.alt}
          widths={[480, 800, 1200]}
          sizes="(min-width: 72rem) 26rem, (min-width: 48rem) 38vw, 100vw"
          formats={['avif']}
          fallbackFormat="webp"
          class="h-auto w-full max-w-[900px] rounded-xl border border-sandstone"
        />
      ) : (
        <div class="placeholder-pattern hidden h-36 w-56 rounded-xl border border-sandstone md:block" aria-hidden="true" />
      )
    }
  </div>
</div>
