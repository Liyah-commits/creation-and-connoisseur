---
/**
 * A program or news post in a list. The whole card is not a link: only the
 * heading is, so screen reader users hear a short link name. The photo is the
 * entry's own image, or `photo` when the page passes another one (the Home
 * page does, so no photo appears twice on it, D58). With no photo there is no
 * image slot at all.
 */
import { Picture } from 'astro:assets';
import { entryPath, type Lang } from '../i18n/routes';
import { formatDate, t } from '../i18n/ui';
import type { NewsEntry, Photo, ProgramEntry, Section } from '../lib/content';

interface Props {
  lang: Lang;
  section: Section;
  entry: ProgramEntry | NewsEntry;
  headingLevel?: 'h2' | 'h3';
  /** A photo to show instead of the entry's own image. */
  photo?: Photo | null | undefined;
}
const { lang, section, entry, headingLevel = 'h2', photo } = Astro.props;
const Heading = headingLevel;
const image: Photo | null = photo ?? (entry.data.image.discriminant ? entry.data.image.value : null);
const date = 'date' in entry.data ? entry.data.date : null;
---

<article class="card flex h-full flex-col overflow-hidden">
  {
    image && (
      <Picture src={image.image} alt={image.alt} widths={[400, 800]} sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw" formats={['avif']} fallbackFormat="webp" class="aspect-[3/2] w-full object-cover object-[center_30%]" />
    )
  }
  <div class="flex flex-1 flex-col gap-2 p-5">
    <Heading class="text-xl">
      <a href={entryPath(section, lang, entry.id)} class="text-ink">{entry.data.title}</a>
    </Heading>
    {date && <p class="text-sm text-ink-muted"><time datetime={date.toISOString().slice(0, 10)}>{formatDate(lang, date)}</time></p>}
    <p>{entry.data.summary}</p>
    {entry.data.draft && <p class="mt-auto inline-block self-start rounded bg-sandstone px-2 py-0.5 text-sm font-semibold text-ink">{t(lang, 'draft.badge')}</p>}
  </div>
</article>
